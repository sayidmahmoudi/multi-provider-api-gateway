APP_NAME=Multi-Provider API Gateway
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://gateway:gateway@db:5432/gateway
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=gateway
AUDIT_STREAM_MAX_LENGTH=1000000
AUDIT_RESERVATION_TTL_SECONDS=120
AUDIT_BATCH_SIZE=500
OTEL_ENABLED=true
OTEL_SERVICE_NAME=multi-provider-api-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
SERVICE_RPS=100
SERVICE_BURST=200
SERVICE_MAX_CONCURRENCY=100
CAPACITY_LEASE_TTL_SECONDS=120

PROVIDER_A_URL=http://92.114.51.251:8001/v1/process
PROVIDER_B_URL=http://92.114.51.251:8002/v1/process
PROVIDER_C_URL=http://92.114.51.251:8003/v1/process

PROVIDER_RETRY_ENABLED=false
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.25

PROVIDER_A_RPS=5
PROVIDER_A_BURST=5
PROVIDER_A_MAX_CONCURRENCY=10

PROVIDER_B_RPS=10
PROVIDER_B_BURST=10
PROVIDER_B_MAX_CONCURRENCY=20

PROVIDER_C_RPS=10
PROVIDER_C_BURST=10
PROVIDER_C_MAX_CONCURRENCY=20
